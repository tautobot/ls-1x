ENV_NAME=test
APP_PORT=5001
STAPP_PORT=8501

# DevOps
CONTAINER_PROJECT=horus_app
DOCKER_NETWORK=horus_network
DB_CONTAINER_NAME=horus_PG_c

PREPROCESSING_FILE="/tmp/knowledge_base.txt"

# Log Level
LOG_LEVEL=INFO

# 8X URL
X8_DOMAIN="lite.1xbet-new.com"
X8_BASE_URL="https://lite.1xbet-new.com"
X8_LIVE_FOOTBALL="/en/live/football"
X8_LIVE_1="/service-api/LiveFeed/GetGameZip"
X8_LIVE_1_PARAM="&lng=en&isSubGames=true&GroupEvents=true&countevents=250&userId=17721013&grMode=4&topGroups=96,27,14,136,303,307,309,7961,275&country=43&marketType=1"
X8_NUM_GAMES="/service-api/LiveFeed/GetSportsShortZip?sports=1&lng=en&gr=819&country=43&virtualSports=true&groupChamps=true"
X8_OPEN_BET="/service-api/LiveBet/Open/UpdateCoupon"
X8_BET_HISTORY="/bethistory-api/Web/GetBetInfoHistoryByDates"
X8_BALANCE="/web-api/user/balance"
X8_COOKIE=""
X8_AUTH=""

# LIVESCORE (local in-process file-backed store; leave JSON_DB_PATH empty to use <repo>/db.json)
JSON_DB_PATH=

# ── LIVE-MATCH SYNC SUBSYSTEM (sync_matches.py / horus.json_sync) ─────────────
# Provider base URLs use SYNC_* names to avoid colliding with the legacy X8_*
# vars above (which the retired fetch code used). Defaults below match the code's
# built-in defaults; override here only if a provider host changes.
SYNC_X1_BASE_URL="https://1xbet.mobi"
SYNC_X1_DOMAIN="1xbet.mobi"
SYNC_X8_BASE_URL="https://api.8xbet.com"
SYNC_X8_ORIGIN="https://8xbet.com"
SYNC_X8_DOMAIN="api.8xbet.com"
# Loop timing (seconds)
SYNC_MATCH_FINDER_INTERVAL=30
SYNC_MATCH_UPDATER_INTERVAL=10
# structlog level for the sync service (DEBUG => human-readable console output)
SYNC_LOG_LEVEL=INFO
# Store collection the sync service writes into (bare name, not SYNC_-prefixed)
JSON_SYNC_SOURCE=1x
# Run the sync IN-PROCESS inside the Streamlit app (default on). Required on
# Streamlit Community Cloud, which runs only `streamlit run` (no separate
# service). Set to 0 on a host that runs sync_matches.py as its own service.
EMBEDDED_SYNC=1